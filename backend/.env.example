DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=atendimento_psicologico

JWT_SECRET=seu_segredo_jwt_muito_seguro_aqui
JWT_EXPIRES_IN=7d

PORT=3000
NODE_ENV=development

# Conexão TLS do MySQL em nuvem. Deixe false para MySQL local.
DB_SSL=false
# Caminho opcional para o certificado CA fornecido pelo seu provedor MySQL.
# DB_SSL_CA_PATH=C:/caminho/ca.pem

# SMTP para envio dos links de recuperação de senha
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
APP_URL=http://localhost:5500/web/index.html

# Domínio Jitsi usado nas consultas por vídeo
JITSI_DOMAIN=meet.jit.si

